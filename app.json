{
  "expo": {
    "name": "reader",
    "slug": "snack-e644c680-05c7-403b-8768-9471989c8eef",
    "newArchEnabled": true,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snanne.quranreader",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.snanne.quranreader",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/QuranReader"
    },
    "plugins": [
      "expo-asset",
      "expo-audio",
      "expo-video",
      "expo-av"
    ],
    "extra": {
      "eas": {
        "projectId": "d69a13b4-1327-4df5-b087-bbb0c0dc1d74"
      }
    },
    "owner": "cirtaa"
  }
}
